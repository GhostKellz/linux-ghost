+static u32 ghost_reciprocal_lut[BURST_CACHE_SAMPLE_LIMIT + 1];
+
+DEFINE_STATIC_KEY_TRUE(sched_burst_inherit_key);
+DEFINE_STATIC_KEY_TRUE(sched_burst_ancestor_key);
+
+static const char * const audio_patterns[] = {
+	"pipewire", "pw-", "pulseaudio", "jack", "alsa", NULL,
+};
+
+static const char * const input_patterns[] = {
+	"evdev", "libinput", "input-", NULL,
+};
+
+static const char * const compositor_patterns[] = {
+	"sway", "mutter", "gnome-shell", "kwin", "hyprland", "Xwayland", "gamescope", NULL,
+};
+
+static const char * const gaming_patterns[] = {
+	"steam", "proton", "wine", "wine64", "lutris", "heroic", ".exe", NULL,
+};
+
+static const char * const wineserver_patterns[] = {
+	"wineserver", "wineserver64", NULL,
+};
+
+static const char * const network_patterns[] = {
+	"NetworkManager", "wpa_supplicant", "systemd-resolve", NULL,
+};
+
+static const char * const batch_patterns[] = {
+	"make", "ninja", "gcc", "g++", "clang", "rustc", "cargo", "ld", NULL,
+};
+
+static bool match_pattern(const char *str, const char * const *patterns)
+{
+	const char *pattern;
+	int i;
+
+	if (!str)
+		return false;
+
+	for (i = 0; (pattern = patterns[i]) != NULL; i++) {
+		if (strstr(str, pattern))
+			return true;
+	}
+
+	return false;
+}
+
+static inline u32 log2p1_u64_u32fp(u64 v, u8 fp)
+{
+	if (unlikely(!v))
+		return 0;
+
+	return (fls64(v) << fp) |
+		(u32)((v << (64 - fls64(v))) << 1 >> (64 - fp));
+}
+
+static void ghost_classify_task(struct task_struct *p)
+{
+	struct ghost_ctx *ctx = &p->ghost;
+	char comm[TASK_COMM_LEN];
+	u64 now = ktime_get_ns();
+
+	if (ctx->last_classify_time &&
+	    now - ctx->last_classify_time < GHOST_CLASSIFY_INTERVAL)
+		return;
+
+	ctx->last_classify_time = now;
+	ctx->task_class = GHOST_CLASS_DEFAULT;
+	ctx->class_boost = 0;
+	ctx->is_latency_sensitive = false;
+
+	get_task_comm(comm, p);
+
+	if (match_pattern(comm, wineserver_patterns)) {
+		ctx->task_class = GHOST_CLASS_WINESERVER;
+		ctx->class_boost = sched_ghost_gaming_boost + 4;
+		ctx->is_latency_sensitive = true;
+		return;
+	}
+
+	if (match_pattern(comm, audio_patterns)) {
+		ctx->task_class = GHOST_CLASS_AUDIO;
+		ctx->class_boost = sched_ghost_audio_boost;
+		ctx->is_latency_sensitive = true;
+		return;
+	}
+
+	if (match_pattern(comm, input_patterns)) {
+		ctx->task_class = GHOST_CLASS_INPUT;
+		ctx->class_boost = sched_ghost_input_boost;
+		ctx->is_latency_sensitive = true;
+		return;
+	}
+
+	if (match_pattern(comm, compositor_patterns)) {
+		ctx->task_class = GHOST_CLASS_COMPOSITOR;
+		ctx->class_boost = sched_ghost_compositor_boost;
+		ctx->is_latency_sensitive = true;
+		return;
+	}
+
+	if (match_pattern(comm, gaming_patterns)) {
+		ctx->task_class = GHOST_CLASS_GAMING;
+		ctx->class_boost = sched_ghost_gaming_boost;
+		ctx->is_latency_sensitive = true;
+		return;
+	}
+
+	if (match_pattern(comm, network_patterns)) {
+		ctx->task_class = GHOST_CLASS_NETWORK;
+		ctx->class_boost = 2;
+		ctx->is_latency_sensitive = true;
+		return;
+	}
+
+	if (match_pattern(comm, batch_patterns))
+		ctx->task_class = GHOST_CLASS_BATCH;
+}
+
+const char *ghost_task_class_name(struct task_struct *p)
+{
+	ghost_classify_task(p);
+
+	switch (p->ghost.task_class) {
+	case GHOST_CLASS_AUDIO:
+		return "audio";
+	case GHOST_CLASS_INPUT:
+		return "input";
+	case GHOST_CLASS_COMPOSITOR:
+		return "compositor";
+	case GHOST_CLASS_GAMING:
+		return "gaming";
+	case GHOST_CLASS_WINESERVER:
+		return "wineserver";
+	case GHOST_CLASS_NETWORK:
+		return "network";
+	case GHOST_CLASS_BATCH:
+		return "batch";
+	default:
+		return "default";
+	}
+}
+
+static inline u32 calc_burst_penalty(struct task_struct *p, u64 burst_time)
+{
+	u32 greed = log2p1_u64_u32fp(burst_time, 8);
+	u32 tolerance = sched_burst_penalty_offset << 8;
+	s32 diff = (s32)(greed - tolerance);
+	u32 penalty = diff & ~(diff >> 31);
+	u32 scaled_penalty = penalty * sched_burst_penalty_scale >> 10;
+	s32 overflow;
+
+	ghost_classify_task(p);
+	if (p->ghost.is_latency_sensitive)
+		scaled_penalty >>= 2;
+
+	overflow = scaled_penalty - MAX_BURST_PENALTY;
+	return scaled_penalty - (overflow & ~(overflow >> 31));
+}
+
+static inline u64 rescale_slice(u64 delta, u8 old_prio, u8 new_prio)
+{
+	u64 unscaled, rescaled;
+
+	unscaled = mul_u64_u32_shr(delta, sched_prio_to_weight[old_prio], 10);
+	rescaled = mul_u64_u32_shr(unscaled, sched_prio_to_wmult[new_prio], 22);
+	return rescaled;
+}
+
+static inline u32 binary_smooth(u32 new, u32 old)
+{
+	u32 is_growing = (new > old);
+	u32 increment = (new - old) * is_growing;
+	u32 shift = sched_burst_smoothness;
+	u32 smoothed = old + ((increment + (1U << shift) - 1) >> shift);
+
+	return (new & ~(-is_growing)) | (smoothed & (-is_growing));
+}
+
+static void reweight_task_by_prio(struct task_struct *p, int prio)
+{
+	struct sched_entity *se = &p->se;
+	unsigned long weight;
+
+	if (task_has_idle_policy(p))
+		return;
+
+	weight = scale_load(sched_prio_to_weight[prio]);
+	if (se->on_rq) {
+		p->ghost.stop_update = true;
+		reweight_entity(cfs_rq_of(se), se, weight);
+		p->ghost.stop_update = false;
+	} else {
+		se->load.weight = weight;
+	}
+	se->load.inv_weight = sched_prio_to_wmult[prio];
+}
+
+u8 effective_prio_ghost(struct task_struct *p)
+{
+	int prio = p->static_prio - MAX_RT_PRIO;
+
+	ghost_classify_task(p);
+	if (static_branch_likely(&sched_ghost_key)) {
+		prio += p->ghost.score;
+		prio -= p->ghost.class_boost;
+	}
+	prio &= ~(prio >> 31);
+	prio = min(prio, maxval_prio);
+	return (u8)prio;
+}
+
+static void update_penalty(struct task_struct *p)
+{
+	struct ghost_ctx *ctx = &p->ghost;
+	u8 prev_prio = effective_prio_ghost(p);
+	s32 diff = (s32)ctx->curr_penalty - (s32)ctx->prev_penalty;
+	u16 max_val = ctx->curr_penalty - (diff & (diff >> 31));
+	u32 is_kthread = !!(p->flags & PF_KTHREAD);
+	u8 new_prio;
+
+	ctx->penalty = max_val & -(s32)(!is_kthread);
+	new_prio = effective_prio_ghost(p);
+	if (new_prio != prev_prio)
+		reweight_task_by_prio(p, new_prio);
+}
+
+void update_curr_ghost(struct task_struct *p, u64 delta_exec)
+{
+	struct ghost_ctx *ctx = &p->ghost;
+	u32 curr_penalty;
+
+	if (ctx->stop_update)
+		return;
+
+	ctx->burst_time += delta_exec;
+	curr_penalty = ctx->curr_penalty = calc_burst_penalty(p, ctx->burst_time);
+	if (curr_penalty <= ctx->prev_penalty)
+		return;
+	update_penalty(p);
+}
+
+void restart_burst_ghost(struct task_struct *p)
+{
+	struct ghost_ctx *ctx = &p->ghost;
+	u32 new_penalty = binary_smooth(ctx->curr_penalty, ctx->prev_penalty);
+
+	ctx->prev_penalty = new_penalty;
+	ctx->curr_penalty = 0;
+	ctx->burst_time = 0;
+	update_penalty(p);
+}
+
+void restart_burst_rescale_deadline_ghost(struct task_struct *p)
+{
+	struct sched_entity *se = &p->se;
+	s64 vscaled, vremain = se->deadline - se->vruntime;
+	u8 old_prio = effective_prio_ghost(p);
+	u8 new_prio;
+
+	restart_burst_ghost(p);
+	new_prio = effective_prio_ghost(p);
+	if (old_prio > new_prio) {
+		vscaled = rescale_slice(abs(vremain), old_prio, new_prio);
+		if (unlikely(vremain < 0))
+			vscaled = -vscaled;
+		se->deadline = se->vruntime + vscaled;
+	}
+}
+
+static inline bool task_is_ghost_eligible(struct task_struct *p)
+{
+	return p && p->sched_class == &fair_sched_class && !p->exit_state;
+}
+
+#ifndef for_each_child_task
+#define for_each_child_task(p, t) \
+	list_for_each_entry_rcu(t, &(p)->children, sibling)
+#endif
+
+static inline u32 count_children_upto2(struct task_struct *p)
+{
+	struct list_head *head = &p->children;
+	struct list_head *next = head->next;
+
+	return (next != head) + (next->next != head);
+}
+
+static inline bool burst_cache_expired(struct ghost_bc *bc, u64 now)
+{
+	struct ghost_bc bc_val = { .value = READ_ONCE(bc->value) };
+	u64 timestamp = (u64)bc_val.timestamp << GHOST_BC_TIMESTAMP_SHIFT;
+
+	return now - timestamp > (u64)sched_burst_cache_lifetime;
+}
+
+static void update_burst_cache(struct ghost_bc *bc,
+		struct task_struct *p, u32 count, u32 total, u64 now)
+{
+	u32 average = (count == 1) ? total :
+		(u32)(((u64)total * ghost_reciprocal_lut[count]) >> 32);
+	struct ghost_bc new_bc = {
+		.penalty = max(average, p->ghost.penalty),
+		.timestamp = now >> GHOST_BC_TIMESTAMP_SHIFT,
+	};
+
+	WRITE_ONCE(bc->value, new_bc.value);
+}
+
+static u32 inherit_from_parent(struct task_struct *parent,
+				      u64 clone_flags, u64 now)
+{
+	struct ghost_bc bc_val;
+	struct ghost_bc *bc;
+	struct task_struct *child;
+	u32 count = 0, total = 0, scan_count = 0;
+
+	if (clone_flags & CLONE_PARENT)
+		parent = rcu_dereference(parent->real_parent);
+
+	bc = &parent->ghost.subtree;
+	if (burst_cache_expired(bc, now)) {
+		for_each_child_task(parent, child) {
+			if (count >= BURST_CACHE_SAMPLE_LIMIT ||
+			    scan_count++ >= BURST_CACHE_SCAN_LIMIT)
+				break;
+			if (!task_is_ghost_eligible(child))
+				continue;
+			count++;
+			total += child->ghost.penalty;
+		}
+		update_burst_cache(bc, parent, count, total, now);
+	}
+
+	bc_val.value = READ_ONCE(bc->value);
+	return (u32)bc_val.penalty;
+}
+
+static u32 inherit_from_ancestor_hub(struct task_struct *parent,
+					   u64 clone_flags, u64 now)
+{
+	struct ghost_bc bc_val;
+	struct task_struct *ancestor = parent;
+	u32 sole_child_count = 0;
+
+	if (clone_flags & CLONE_PARENT) {
+		ancestor = rcu_dereference(ancestor->real_parent);
+		sole_child_count = 1;
+	}
+
+	for (struct task_struct *next;
+	     (next = rcu_dereference(ancestor->real_parent)) != ancestor &&
+	     count_children_upto2(ancestor) <= sole_child_count;
+	     ancestor = next, sole_child_count = 1) {}
+
+	struct ghost_bc *bc = &ancestor->ghost.subtree;
+	if (burst_cache_expired(bc, now)) {
+		struct task_struct *direct_child;
+		u32 count = 0, total = 0, scan_count = 0;
+
+		for_each_child_task(ancestor, direct_child) {
+			struct task_struct *descendant = direct_child;
+
+			if (count >= BURST_CACHE_SAMPLE_LIMIT ||
+			    scan_count++ >= BURST_CACHE_SCAN_LIMIT)
+				break;
+			while (count_children_upto2(descendant) == 1)
+				descendant = list_first_entry(&descendant->children,
+							    struct task_struct, sibling);
+			if (!task_is_ghost_eligible(descendant))
+				continue;
+			count++;
+			total += descendant->ghost.penalty;
+		}
+		update_burst_cache(bc, ancestor, count, total, now);
+	}
+
+	bc_val.value = READ_ONCE(bc->value);
+	return (u32)bc_val.penalty;
+}
+
+static u32 inherit_from_thread_group(struct task_struct *p, u64 now)
+{
+	struct ghost_bc bc_val;
+	struct task_struct *leader = p->group_leader;
+	struct ghost_bc *bc = &leader->ghost.group;
+	struct task_struct *sibling;
+	u32 count = 0, total = 0;
+
+	if (burst_cache_expired(bc, now)) {
+		for_each_thread(leader, sibling) {
+			if (count >= BURST_CACHE_SAMPLE_LIMIT)
+				break;
+			if (!task_is_ghost_eligible(sibling))
+				continue;
+			count++;
+			total += sibling->ghost.penalty;
+		}
+		update_burst_cache(bc, leader, count, total, now);
+	}
+
+	bc_val.value = READ_ONCE(bc->value);
+	return (u32)bc_val.penalty;
+}
+
+void task_fork_ghost(struct task_struct *p, struct task_struct *parent,
+			     u64 clone_flags, u64 now)
+{
+	struct ghost_ctx *ctx = &p->ghost;
+	u32 inherited_penalty;
+
+	if (!static_branch_likely(&sched_ghost_key) || !task_is_ghost_eligible(p))
+		return;
+
+	rcu_read_lock();
+	if (clone_flags & CLONE_THREAD)
+		inherited_penalty = inherit_from_thread_group(parent, now);
+	else if (static_branch_likely(&sched_burst_inherit_key))
+		inherited_penalty = static_branch_likely(&sched_burst_ancestor_key) ?
+			inherit_from_ancestor_hub(parent, clone_flags, now) :
+			inherit_from_parent(parent, clone_flags, now);
+	else
+		inherited_penalty = 0;
+
+	if (ctx->prev_penalty < inherited_penalty)
+		ctx->prev_penalty = inherited_penalty;
+	ctx->curr_penalty = 0;
+	ctx->burst_time = 0;
+	ctx->stop_update = false;
+	ctx->futex_waiting = false;
+	ctx->task_class = parent->ghost.task_class;
+	ctx->class_boost = parent->ghost.class_boost;
+	ctx->is_latency_sensitive = parent->ghost.is_latency_sensitive;
+	ctx->last_classify_time = 0;
+	update_penalty(p);
+	rcu_read_unlock();
+}
+
+void reset_task_ghost(struct task_struct *p)
+{
+	memset(&p->ghost, 0, sizeof(struct ghost_ctx));
+}
+
+static void update_inherit_type(void)
+{
+	switch (sched_burst_inherit_type) {
+	case 1:
+		static_branch_enable(&sched_burst_inherit_key);
+		static_branch_disable(&sched_burst_ancestor_key);
+		break;
+	case 2:
+		static_branch_enable(&sched_burst_inherit_key);
+		static_branch_enable(&sched_burst_ancestor_key);
+		break;
+	default:
+		static_branch_disable(&sched_burst_inherit_key);
+		break;
+	}
+}
+
+void __init sched_init_ghost(void)
+{
+	pr_info("%s %s by %s\n",
+		SCHED_GHOST_PROGNAME, SCHED_GHOST_VERSION, SCHED_GHOST_AUTHOR);
+
+	for (int i = 1; i <= BURST_CACHE_SAMPLE_LIMIT; i++)
+		ghost_reciprocal_lut[i] = (u32)div64_u64(0xffffffffULL + i, i);
+
+	reset_task_ghost(&init_task);
+	update_inherit_type();
+}
+
+static void readjust_all_task_weights(void)
+{
+	struct task_struct *task;
+	struct rq *rq;
+	struct rq_flags rf;
+
+	scoped_guard(write_lock_irq, &tasklist_lock)
+	for_each_process(task) {
+		if (!task_is_ghost_eligible(task))
+			continue;
+		ghost_classify_task(task);
+		rq = task_rq_lock(task, &rf);
+		update_rq_clock(rq);
+		reweight_task_by_prio(task, effective_prio_ghost(task));
+		task_rq_unlock(rq, task, &rf);
+	}
+}
+
+int sched_ghost_update_handler(const struct ctl_table *table,
+		int write, void __user *buffer, size_t *lenp, loff_t *ppos)
+{
+	int ret = proc_dou8vec_minmax(table, write, buffer, lenp, ppos);
+
+	if (ret || !write)
+		return ret;
+
+	if (sched_ghost)
+		static_branch_enable(&sched_ghost_key);
+	else
+		static_branch_disable(&sched_ghost_key);
+
+	readjust_all_task_weights();
+	return 0;
+}
+
+int sched_burst_inherit_type_update_handler(const struct ctl_table *table,
+		int write, void __user *buffer, size_t *lenp, loff_t *ppos)
+{
+	int ret = proc_dou8vec_minmax(table, write, buffer, lenp, ppos);
+
+	if (ret || !write)
+		return ret;
+
+	update_inherit_type();
+	return 0;
+}
+
